# ============================================================
# Surprises — Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` a git ni expongas claves al cliente.
# ============================================================

# ---- Supabase (solo catálogo: categorías y productos) ----
# Se usa únicamente para guardar las ENTIDADES del catálogo.
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings → API → anon public key (clave pública, puede ir al cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Project Settings → API → service_role secret (SOLO SERVIDOR).
# Se usa para las operaciones administrativas (crear, editar, eliminar).
# Nunca incluyas esta clave en código que se ejecute en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---- Cloudinary (SOLO IMÁGENES, subida dinámica) ----
# Las imágenes se suben de forma dinámica desde el Admin vía /api/upload.
# Dashboard → Settings → API Keys (o Account)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ---- WhatsApp (Pedidos / Contacto) ----
# Número del negocio en formato internacional sin "+" ni espacios.
# El botón "Pedir por WhatsApp" genera el mensaje del carrito
# (solo nombre del producto y cantidad) hacia este número.
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
