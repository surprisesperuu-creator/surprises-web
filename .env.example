# ============================================================
# Surprises — Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` a git ni expongas claves al cliente.
# ============================================================

# ---- Prisma Postgres ----
# Sustituye los marcadores copiando las URLs correspondientes de Prisma Console.
# Una sola conexión: la aplicación y Prisma Migrate usan DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# DIRECT_URL ya no es necesario: se usa una única conexión mediante DATABASE_URL.
# Si Prisma Migrate falla sobre la conexión pooled, añade DIRECT_URL solo para migraciones:
# DIRECT_URL=postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# Solo durante la migración de datos: URL de lectura de la base de origen.
SOURCE_DATABASE_URL=

# ---- Cloudinary (SOLO IMÁGENES, subida dinámica) ----
# Las imágenes se suben de forma dinámica desde el Admin vía /api/upload.
# Dashboard → Settings → API Keys (o Account)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ---- Acceso administrativo (solo servidor; nunca usar NEXT_PUBLIC_) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Genera un valor aleatorio de al menos 32 caracteres y mantenlo privado.
ADMIN_SESSION_SECRET=

# ---- WhatsApp (Pedidos / Contacto) ----
# Número del negocio en formato internacional sin "+" ni espacios.
# El botón "Pedir por WhatsApp" genera el mensaje del carrito
# (solo nombre del producto y cantidad) hacia este número.
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
